# Neon Postgres (API)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=4000
# Comma-separated browser origins allowed by CORS (your Vercel URL + local).
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
SEED_ADMIN_EMAIL=admin@rubiescuisine.local
SEED_ADMIN_PASSWORD=changeme123

# Production cross-origin cookies (Vercel → Render). Default when NODE_ENV=production.
# COOKIE_SAMESITE=none

# Paystack (GHS). Leave unset or set to test_mock for local mock checkout.
# PAYSTACK_SECRET_KEY=sk_test_xxx
# PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Resend (email alerts — orders, catering). Add your key from https://resend.com
# RESEND_API_KEY=re_xxx
# Verified sender; until then Resend's test from works for your own inbox:
# RESEND_FROM_EMAIL=Rubies Cuisine <onboarding@resend.dev>
# Later: Rubies Cuisine <orders@yourdomain.com>

# Neon Object Storage (S3-compatible). From Neon Console → Connect → Storage.
# Create a public_read bucket (e.g. rubies-media) for menu photos.
# AWS_ACCESS_KEY_ID=nak_live_...
# AWS_SECRET_ACCESS_KEY=nsk_live_...
# AWS_ENDPOINT_URL_S3=https://br-xxxx.storage.c-x.REGION.aws.neon.tech
# AWS_REGION=us-east-2
# NEON_STORAGE_BUCKET=rubies-media
# Optional CDN/custom public base (otherwise uses endpoint/bucket/key):
# NEON_STORAGE_PUBLIC_BASE_URL=https://br-xxxx.storage.../rubies-media
